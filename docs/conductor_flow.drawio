        <mxCell id="t1" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;align=left;verticalAlign=top;spacing=5;fontSize=10;" value="&lt;b&gt;FREE&lt;/b&gt;&amp;nbsp; every tick, &lt;b&gt;10 Hz&lt;/b&gt;&amp;nbsp; · costs nothing&lt;br/&gt;&lt;b&gt;from:&lt;/b&gt; the skill&#39;s own status — aperture, effort, base pose, runstop, elapsed, tick count&lt;br/&gt;&lt;b&gt;catches:&lt;/b&gt; empty grasp (debounced 3 settled samples), stall, timeout, structural stop predicates" vertex="1">
          <mxGeometry height="70" width="380" x="405" y="1005" as="geometry" />
        </mxCell>
        <mxCell id="t2" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;align=left;verticalAlign=top;spacing=5;fontSize=10;" value="&lt;b&gt;GROUNDING&lt;/b&gt;&amp;nbsp; &lt;b&gt;1 Hz&lt;/b&gt;&amp;nbsp; · one grounder call&lt;br/&gt;&lt;b&gt;only when&lt;/b&gt; the stop predicate names an object (object_in_view / object_at_target)&lt;br/&gt;&lt;b&gt;from:&lt;/b&gt; a fresh RGB-D frame → Grounder&amp;nbsp;&amp;nbsp;&lt;b&gt;answers:&lt;/b&gt; is it in view / is it at the target yet" vertex="1">
          <mxGeometry height="70" width="380" x="405" y="1085" as="geometry" />
        </mxCell>
        <mxCell id="t3" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;align=left;verticalAlign=top;spacing=5;fontSize=10;dashed=1;" value="&lt;b&gt;VLM&lt;/b&gt;&amp;nbsp; &lt;b&gt;0.2 Hz&lt;/b&gt; (every 5 s)&amp;nbsp; · one model call&amp;nbsp; · &lt;b&gt;OFF&lt;/b&gt; unless the planner declared a vlm_predicate&lt;br&gt;&lt;b&gt;from:&lt;/b&gt; one frame captured only for this check&amp;nbsp;&amp;nbsp;&lt;b&gt;answers:&lt;/b&gt; yes/no + evidence&lt;br&gt;An exception handler - not run on every tick as its too expensive!" vertex="1">
          <mxGeometry height="70" width="380" x="405" y="1160" as="geometry" />
        </mxCell>
        <mxCell id="dec" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;align=left;verticalAlign=top;spacing=6;fontSize=11;" value="&lt;b&gt;Decision&lt;/b&gt;&lt;br/&gt;stop now, and say why&lt;br/&gt;&lt;br/&gt;PREDICATE — it worked&lt;br/&gt;MONITOR — cut short&lt;br/&gt;TIMEOUT · ERROR" vertex="1">
          <mxGeometry height="120" width="200" x="861" y="1035" as="geometry" />
        </mxCell>
        <mxCell id="e_s4_sk" edge="1" parent="1" source="s4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#000000;fontColor=#000000;fontSize=10;endArrow=block;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.5;entryX=0.167;entryY=0;" target="sk" value="a skill call:&lt;br/&gt;seconds, and stoppable">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="120" y="637" />
              <mxPoint x="120" y="1000" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e_sk_sup" edge="1" parent="1" source="sk" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#000000;fontColor=#000000;fontSize=10;endArrow=block;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.45;" target="sup" value="status,&lt;br/&gt;every tick">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_sup_dec" edge="1" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#000000;fontColor=#000000;endArrow=block;entryX=0;entryY=0.5;" target="dec">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="804" y="1095" as="sourcePoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="e_dec_sk" edge="1" parent="1" source="dec" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#000000;fontColor=#000000;fontSize=10;endArrow=block;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=1;entryY=0.85;" target="sk" value="stop(reason) — the first tier that fires wins">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="940" y="1250" />
              <mxPoint x="350" y="1250" />
              <mxPoint x="350" y="1127" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e_dec_s5" edge="1" parent="1" source="dec" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#000000;fontColor=#000000;fontSize=10;endArrow=block;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=0;entryX=1;entryY=0.5;" target="s5" value="the step result goes back into the turn:&lt;br/&gt;stop cause · ticks · grounder calls · VLM calls">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="940" y="724" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="endbox" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;align=left;verticalAlign=top;spacing=6;fontSize=11;" value="&lt;b&gt;The episode is over&lt;/b&gt;&lt;br/&gt;done(success) that the monitor verified, done(failure), or the step budget spent" vertex="1">
          <mxGeometry height="80" width="230" x="100" y="1360" as="geometry" />
        </mxCell>
        <mxCell id="cons" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;align=left;verticalAlign=top;spacing=6;fontSize=11;strokeWidth=2;" value="&lt;b&gt;_consolidate()&lt;/b&gt; — the learning step&lt;br/&gt;this is the only moment memory is written" vertex="1">
          <mxGeometry height="80" width="250" x="430" y="1360" as="geometry" />
        </mxCell>
        <mxCell id="logbox" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;align=left;verticalAlign=top;spacing=6;fontSize=11;" value="&lt;b&gt;_write_log()&lt;/b&gt;&amp;nbsp; logs/&amp;lt;name&amp;gt;/episode_*.json&lt;br/&gt;every call, result and verdict — written whether or not it worked" vertex="1">
          <mxGeometry height="70" width="250" x="430" y="1465" as="geometry" />
        </mxCell>
        <mxCell id="e_d1_end" edge="1" parent="1" source="d1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#000000;fontColor=#000000;fontSize=10;endArrow=block;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0.5;entryY=0;" target="endbox" value="verified → the episode ends">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1220" y="554" />
              <mxPoint x="1220" y="1332" />
              <mxPoint x="215" y="1332" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e_end_cons" edge="1" parent="1" source="endbox" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#000000;fontColor=#000000;endArrow=block;" target="cons">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_cons_log" edge="1" parent="1" source="cons" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#000000;fontColor=#000000;endArrow=block;" target="logbox">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_write_tm" edge="1" parent="1" source="cons" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#000000;fontColor=#000000;fontSize=10;endArrow=block;dashed=1;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.3;entryX=0.5;entryY=1;" target="tm" value="&lt;b&gt;written at the end:&lt;/b&gt;&amp;nbsp;on success only:&lt;br&gt;the call sequence is abstracted into a trace">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1100" y="1384" />
              <mxPoint x="1100" y="527" />
              <mxPoint x="1415" y="527" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e_write_gm" edge="1" parent="1" source="cons" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#000000;fontColor=#000000;fontSize=10;endArrow=block;dashed=1;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.75;entryX=0.5;entryY=1;" target="gm" value="&lt;b&gt;written at the end&lt;/b&gt; — every failure&lt;br&gt;that fired gets its count bumped, so the&lt;br&gt;prompt surfaces what this robot in this&lt;br&gt;house fails at">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1150" y="1420" />
              <mxPoint x="1150" y="790" />
              <mxPoint x="1415" y="790" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="4BoKtQjDxdAT7YypidVD-5" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;" value="" vertex="1">
          <mxGeometry height="177" width="420" x="814" y="68" as="geometry" />
        </mxCell>
        <mxCell id="4BoKtQjDxdAT7YypidVD-9" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;" value="&lt;font&gt;&lt;span style=&quot;font-size: 10px; text-wrap-mode: nowrap; color: light-dark(rgb(254, 254, 254), rgb(249, 249, 249));&quot;&gt;&lt;b&gt;Read into the prompt:&amp;nbsp;&lt;/b&gt;&lt;br&gt;- Once per episode: Everything memory knows&lt;/span&gt;&lt;/font&gt;&lt;div&gt;&lt;font&gt;&lt;span style=&quot;font-size: 10px; text-wrap-mode: nowrap; color: light-dark(rgb(254, 254, 254), rgb(249, 249, 249));&quot;&gt;- Every step - The few rules that bear on what just happened&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font&gt;&lt;span style=&quot;font-size: 10px; text-wrap-mode: nowrap; color: light-dark(rgb(254, 254, 254), rgb(249, 249, 249));&quot;&gt;- On a new subgoal / if there have been 3 failures - swap in a different trace&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="65" width="347" x="838" y="393" as="geometry" />
        </mxCell>
        <mxCell id="4BoKtQjDxdAT7YypidVD-11" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;" value="PRIMITIVES - Fixed set of Planner Actions&amp;nbsp;&amp;nbsp;" vertex="1">
          <mxGeometry height="30" width="156" x="1401" y="38" as="geometry" />
        </mxCell>
        <mxCell id="4BoKtQjDxdAT7YypidVD-14" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;" value="&lt;br&gt;&lt;div&gt;STOP PREDICATE:&amp;nbsp;&lt;span style=&quot;font-family: -apple-system, BlinkMacSystemFont, &amp;quot;Segoe WPC&amp;quot;, &amp;quot;Segoe UI&amp;quot;, system-ui, Ubuntu, &amp;quot;Droid Sans&amp;quot;, sans-serif; font-size: 14px; background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;Every skill call can declare, in structured form, how the planner will know it worked:&lt;/span&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="70" width="181" x="1401" y="72" as="geometry" />
        </mxCell>
        <mxCell id="4BoKtQjDxdAT7YypidVD-15" edge="1" parent="1" source="4BoKtQjDxdAT7YypidVD-14" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;innerLoopWaypoints=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;" target="4BoKtQjDxdAT7YypidVD-14">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="4BoKtQjDxdAT7YypidVD-16" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;" value="GROUNDING: Using a VLM to convert text into pixel output which is later converted to coordinates using geometry e.g. pick glass -&amp;gt; pick at (3, 6, 7)" vertex="1">
          <mxGeometry height="70" width="181" x="1397" y="164" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="conductor-rates" name="The rates, side by side">
    <mxGraphModel dx="1400" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="r0" />
        <mxCell id="r1" parent="r0" />
        <mxCell id="rtitle" value="&lt;b&gt;The same ten seconds, seen at four rates&lt;/b&gt;&lt;br/&gt;One pick_up, from the planner&#39;s turn down to the control tick. Tick density on each line is drawn to scale." style="text;html=1;align=left;verticalAlign=top;fontSize=14;fontColor=#000000;whiteSpace=wrap;" vertex="1" parent="r1">
          <mxGeometry x="40" y="30" width="900" height="50" as="geometry" />
        </mxCell>
        <mxCell id="startmark" value="skill starts" style="text;html=1;align=left;verticalAlign=bottom;fontSize=10;fontColor=#000000;" vertex="1" parent="r1">
          <mxGeometry x="322" y="90" width="120" height="20" as="geometry" />
        </mxCell>
        <mxCell id="stopmark" value="skill stops" style="text;html=1;align=right;verticalAlign=bottom;fontSize=10;fontColor=#000000;" vertex="1" parent="r1">
          <mxGeometry x="900" y="90" width="120" height="20" as="geometry" />
        </mxCell>
        <mxCell id="vstart" style="endArrow=none;html=1;strokeColor=#000000;dashed=1;dashPattern=4 4;" edge="1" parent="r1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="320" y="110" as="sourcePoint" />
            <mxPoint x="320" y="470" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="vstop" style="endArrow=none;html=1;strokeColor=#000000;dashed=1;dashPattern=4 4;" edge="1" parent="r1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1020" y="110" as="sourcePoint" />
            <mxPoint x="1020" y="470" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <!-- lane 1 -->
        <mxCell id="l1lab" value="&lt;b&gt;THE TURN&lt;/b&gt;&lt;br/&gt;about one per step" style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontColor=#000000;whiteSpace=wrap;" vertex="1" parent="r1">
          <mxGeometry x="40" y="130" width="260" height="50" as="geometry" />
        </mxCell>
        <mxCell id="l1line" style="endArrow=none;html=1;strokeColor=#000000;dashed=1;dashPattern=1 100;strokeWidth=3;" edge="1" parent="r1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="320" y="145" as="sourcePoint" />
            <mxPoint x="1020" y="145" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="l1note" value="&lt;b&gt;in:&lt;/b&gt; a fresh frame, joint state, scan digest, the last result, and the memory block&lt;br/&gt;&lt;b&gt;out:&lt;/b&gt; one JSON primitive call — and afterwards a verdict in English that lands in the next prompt&lt;br/&gt;&lt;b&gt;costs:&lt;/b&gt; one planner call, plus a grounder call if it chose observe" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;align=left;verticalAlign=top;spacing=6;fontSize=10;" vertex="1" parent="r1">
          <mxGeometry x="1070" y="118" width="440" height="70" as="geometry" />
        </mxCell>
        <!-- lane 2 -->
        <mxCell id="l2lab" value="&lt;b&gt;FREE TIER&lt;/b&gt;&lt;br/&gt;10 Hz — every tick, always on" style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontColor=#000000;whiteSpace=wrap;" vertex="1" parent="r1">
          <mxGeometry x="40" y="220" width="260" height="50" as="geometry" />
        </mxCell>
        <mxCell id="l2line" style="endArrow=none;html=1;strokeColor=#000000;dashed=1;dashPattern=1 6;strokeWidth=3;" edge="1" parent="r1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="320" y="235" as="sourcePoint" />
            <mxPoint x="1020" y="235" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="l2note" value="&lt;b&gt;in:&lt;/b&gt; the skill&#39;s own status object — nothing is captured, nothing is asked&lt;br/&gt;&lt;b&gt;out:&lt;/b&gt; stop the skill. Empty grasp, stall, timeout, and any structural stop predicate&lt;br/&gt;&lt;b&gt;costs:&lt;/b&gt; nothing. A test asserts the default run spends zero model calls here" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;align=left;verticalAlign=top;spacing=6;fontSize=10;" vertex="1" parent="r1">
          <mxGeometry x="1070" y="208" width="440" height="70" as="geometry" />
        </mxCell>
        <!-- lane 3 -->
        <mxCell id="l3lab" value="&lt;b&gt;GROUNDING TIER&lt;/b&gt;&lt;br/&gt;1 Hz — only if the stop predicate names an object" style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontColor=#000000;whiteSpace=wrap;" vertex="1" parent="r1">
          <mxGeometry x="40" y="310" width="260" height="60" as="geometry" />
        </mxCell>
        <mxCell id="l3line" style="endArrow=none;html=1;strokeColor=#000000;dashed=1;dashPattern=1 68;strokeWidth=3;" edge="1" parent="r1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="320" y="325" as="sourcePoint" />
            <mxPoint x="1020" y="325" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="l3note" value="&lt;b&gt;in:&lt;/b&gt; a fresh RGB-D frame → one grounder call&lt;br/&gt;&lt;b&gt;out:&lt;/b&gt; is the named object in view, or within tolerance of the target — satisfy the predicate early&lt;br/&gt;&lt;b&gt;costs:&lt;/b&gt; one grounder call per second, hard rate limited" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;align=left;verticalAlign=top;spacing=6;fontSize=10;" vertex="1" parent="r1">
          <mxGeometry x="1070" y="298" width="440" height="70" as="geometry" />
        </mxCell>
        <!-- lane 4 -->
        <mxCell id="l4lab" value="&lt;b&gt;VLM TIER&lt;/b&gt;&lt;br/&gt;0.2 Hz — off unless the planner asked for it" style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontColor=#000000;whiteSpace=wrap;" vertex="1" parent="r1">
          <mxGeometry x="40" y="400" width="260" height="60" as="geometry" />
        </mxCell>
        <mxCell id="l4line" style="endArrow=none;html=1;strokeColor=#000000;dashed=1;dashPattern=1 348;strokeWidth=3;" edge="1" parent="r1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="320" y="415" as="sourcePoint" />
            <mxPoint x="1020" y="415" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="l4note" value="&lt;b&gt;in:&lt;/b&gt; one frame, captured only because this tier asked for it&lt;br/&gt;&lt;b&gt;out:&lt;/b&gt; yes / no + evidence. Stops the skill only on a declared vlm_predicate, or a clear anomaly&lt;br/&gt;&lt;b&gt;costs:&lt;/b&gt; a model call and a second of latency — which is why it is the exception, not the loop" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;align=left;verticalAlign=top;spacing=6;fontSize=10;dashed=1;" vertex="1" parent="r1">
          <mxGeometry x="1070" y="388" width="440" height="70" as="geometry" />
        </mxCell>
        <!-- time axis -->
        <mxCell id="axis" style="endArrow=none;html=1;strokeColor=#000000;" edge="1" parent="r1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="320" y="500" as="sourcePoint" />
            <mxPoint x="1020" y="500" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="ax0" value="0 s" style="text;html=1;align=center;fontSize=10;fontColor=#000000;" vertex="1" parent="r1">
          <mxGeometry x="290" y="505" width="60" height="20" as="geometry" />
        </mxCell>
        <mxCell id="ax5" value="5 s" style="text;html=1;align=center;fontSize=10;fontColor=#000000;" vertex="1" parent="r1">
          <mxGeometry x="640" y="505" width="60" height="20" as="geometry" />
        </mxCell>
        <mxCell id="ax10" value="10 s" style="text;html=1;align=center;fontSize=10;fontColor=#000000;" vertex="1" parent="r1">
          <mxGeometry x="990" y="505" width="60" height="20" as="geometry" />
        </mxCell>
        <mxCell id="rfoot" value="Read the gaps, not the marks. The tier that catches an empty grasp fires a hundred times in this window and costs nothing; the tier that can see anything at all fires twice and costs real money. That is the whole reason supervision is split by rate: put a check on the cheapest line that can answer it, and only fall through when nothing cheaper can." style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontColor=#000000;whiteSpace=wrap;" vertex="1" parent="r1">
          <mxGeometry x="40" y="570" width="1000" height="60" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
