        <mxCell id="sup" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fontSize=11;fontColor=#000000;" value="&lt;b&gt;monitor.Supervisor&lt;/b&gt; — one watcher per skill run, tiered by cost. The cheap tiers do nearly all the work." vertex="1">
          <mxGeometry height="281" width="410" x="390" y="960" as="geometry" />
