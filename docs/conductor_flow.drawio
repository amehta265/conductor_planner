        <mxCell id="sk" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;align=left;verticalAlign=top;spacing=6;fontSize=11;strokeWidth=2;" value="&lt;b&gt;SKILL OBJECT&lt;/b&gt;&amp;nbsp; skills/base.py&lt;br&gt;navigate · pick_up · put_down&lt;br&gt;&lt;br&gt;start() → poll() → stop(reason)&lt;br&gt;&lt;br&gt;&lt;div&gt;A running skill can be cut short.&lt;/div&gt;" vertex="1">
